# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# The channel ID where the Wordle app posts daily results
# (also where the weekly leaderboard will be posted)
CHANNEL_ID=123456789012345678

# The exact display name of the Wordle app that posts daily results
# (check the message author's name in Discord - usually "Wordle")
WORDLE_BOT_NAME=Wordle

# IANA timezone used to determine "the previous day" and week boundaries
# (defaults to America/Chicago for DFW if not set)
TIMEZONE=America/Chicago

# Command prefix for manual commands (!score, !scoreweek, !backfill)
PREFIX=!

# How many past messages to scan on startup (and via !backfill) to pick up
# historical results the bot missed before it was running. 500 covers
# roughly 10+ weeks of daily posts in a typical channel.
BACKFILL_LIMIT=500

# Manual name overrides. Sometimes the Wordle app can't link someone to a
# real Discord mention and falls back to plain text like "@wittle" - the bot
# tries to auto-match that against your server's member list, but if it
# can't find a match, add an explicit override here as JSON:
#   {"wittle": "111111111111111111", "wet_noodle": "222222222222222222"}
# To get someone's Discord user ID: enable Developer Mode (User Settings ->
# Advanced), then right-click their name -> Copy User ID.
ALIASES_JSON={}

# Username (not nickname) of the person who gets roasted whenever they post.
# Toggle the feature on/off in Discord with !rufus.
RUFUS_USERNAME=rufus

# Username (not nickname) of the one person who gets a loving reply instead
# of a hostile one whenever someone @mentions the bot itself.
BOT_OWNER_USERNAME=wittlebean
