# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# The channel ID where the Wordle app posts daily results
# (also where the weekly leaderboard will be posted)
CHANNEL_ID=123456789012345678

# The exact display name of the Wordle app that posts daily results
# (check the message author's name in Discord - usually "Wordle")
WORDLE_BOT_NAME=Wordle

# IANA timezone used to determine "the previous day" and week boundaries
# (defaults to America/Chicago for DFW if not set)
TIMEZONE=America/Chicago

# Command prefix for manual commands (!score, !scoreweek, !backfill)
PREFIX=!

# How many past messages to scan on startup (and via !backfill) to pick up
# historical results the bot missed before it was running. 500 covers
# roughly 10+ weeks of daily posts in a typical channel.
BACKFILL_LIMIT=500
